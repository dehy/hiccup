---
// SPDX-License-Identifier: AGPL-3.0-or-later
import Default from "@astrojs/starlight/components/Footer.astro";
import { CONTENT_BASE } from "../site";
const commit = __BUILD_COMMIT__;
---
<Default {...Astro.props}><slot /></Default>
<p class="build">
  {commit ? <>Built from <a href={`https://github.com/dehy/hiccup/commit/${commit}`}><code>{commit.slice(0, 7)}</code></a>.</> : "Local build."}{" "}
  Website text written against <a href={`https://github.com/dehy/hiccup/commit/${CONTENT_BASE}`}><code>{CONTENT_BASE.slice(0, 7)}</code></a>.
</p>
<style>
  .build { margin-top: 16px; font-size: 13px; line-height: 20px; color: var(--sl-color-gray-3); }
  .build a { color: var(--sl-color-gray-2); }
  .build a:hover { color: var(--sl-color-white); }
</style>
